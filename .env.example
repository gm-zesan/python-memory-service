# Service Settings
MEMORY_SERVICE_HOST=0.0.0.0
MEMORY_SERVICE_PORT=8002

# Database Settings (MySQL connection matching Laravel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatbot_core
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Neo4j Settings
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# Generic Analytics LLM Provider Configuration
ANALYTICS_LLM_API_KEY=your_primary_llm_api_key
ANALYTICS_LLM_BASE_URL=https://api.deepseek.com
ANALYTICS_LLM_MODEL=deepseek-chat

# Generic Analytics Fallback LLM Provider Configuration
ANALYTICS_FALLBACK_LLM_API_KEY=your_fallback_llm_api_key
ANALYTICS_FALLBACK_LLM_BASE_URL=https://api.deepseek.com
ANALYTICS_FALLBACK_LLM_MODEL=deepseek-chat

# Generic Memory Graph LLM Configuration
MEMORY_LLM_PROVIDER=generic
MEMORY_LLM_API_KEY=your_memory_llm_api_key
MEMORY_LLM_BASE_URL=https://api.deepseek.com
MEMORY_LLM_MODEL=deepseek-chat

# Backwards Compatibility Legacy Keys (Optional)
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_URL=https://api.deepseek.com
OPENAI_API_KEY=
